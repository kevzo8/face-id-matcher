# SVI Biometrics Liveness Backend — Configuration
# Copy to .env and fill in values

# Server
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development  # development | staging | production
LOG_LEVEL=info

# AWS (optional — leave blank to use fallback-only mode)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=ap-southeast-1

# API Keys (for client authentication)
API_KEYS=sk_dev_key1,sk_dev_key2

# Session
SESSION_TTL_MINUTES=5

# Rate Limiting
RATE_LIMIT_PER_MINUTE=10

# Audit Logging
AUDIT_LOG_TABLE=liveness_audit  # append-only DB table or CloudWatch log group

# CDN (for SDK auto-update)
SDK_CDN_URL=https://svi-cdn.com/sdk/v1/svi-liveness.js
SDK_MIN_VERSION=1.0.0
